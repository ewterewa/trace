# Option A: OpenAI-hosted model (API key is stored on the backend only)
OPENAI_API_KEY=
TRACE_AI_MODEL=gpt-4.1-mini

# Option B: self-hosted / OpenAI-compatible inference server (no OpenAI key required)
# Example: http://127.0.0.1:8001/v1
# The endpoint must be reachable FROM the TRACE backend host.
TRACE_AI_BASE_URL=

TRACE_DATA_DIR=./data
TRACE_MAX_UPLOAD_MB=20
